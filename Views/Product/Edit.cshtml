@using PetShop.ViewModel;
@model PetShop.ViewModel.ProductViewModels.ProductEditViewModel;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

<div class="container">
    <h4 class="center-align">Editar Producto</h4>
    <form asp-action="Edit" method="post">
        <input type="hidden" name="ProductId" value="@Model.ProductId">
        <div class="input-field">
            <input type="text" id="Name" name="Name" value="@Model.Name" required>
            <label for="Name" class="active">Nombre</label>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="input-field">
            <input type="number" step="0.01" id="Price" name="Price" value="@Model.Price" required>
            <label for="Price" class="active">Precio</label>
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="input-field">
            <input type="number" id="Stock" name="Stock" value="@Model.Stock" required>
            <label for="Stock" class="active">Stock</label>
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
         <div class="input-field">
            <input type="text" id="Cod" name="Cod" value="@Model.Cod" required>
            <label for="Cod">Código</label>
        </div>
        <div class="input-field">
            <input type="text" id="Description" name="Description" value="@Model.Description">
            <label for="Description">Descripción</label>
        </div>
        <button type="submit" class="btn waves-effect waves-light">Guardar Cambios</button>
        <a href="@Url.Action("Index", "Product")" class="btn grey waves-effect waves-light">Cancelar</a>
    </form>
</div>
