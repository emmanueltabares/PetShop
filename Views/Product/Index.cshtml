@using PetShop.ViewModel;
@model PetShop.ViewModel.ProductViewModels.ProductListViewModel;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

<style>
    .container {
        width: 90%;
        margin: 0 auto;
    }
    .table-container {
        width: 100%;
        margin: 0 auto;
    }
    .action-buttons {
        display: inline-block;
        justify-content: center;
        align-items: center;
        gap: 5px;
    }
    .action-cell {
        justify-content: center;
        align-items: center;
        padding: 8px 16px;
        text-align: right;
        white-space: nowrap;
    }
    .action-buttons a {
        margin: 0 5px;
        padding: 0 10px;
        font-size: 0.8rem;
        margin-left: 5px;
    }
    th, td {
        padding: 8px 16px;
        vertical-align: middle;
    }
    .close-btn {
        cursor: pointer;
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 18px;
    }
</style>

<div class="container">
    <h4 class="center-align">Listado de Productos</h4>

    <div class="row mb-3">
        <div class="col-md-6">
            <form asp-controller="Product" asp-action="Index" method="get" class="form-inline">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Buscar por nombre" aria-label="Buscar por nombre" aria-describedby="basic-addon2" name="filter" value="@Model.Filter">
                </div>
                <div class="input-group">
                    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-message" class="card-panel green lighten-4" style="padding: 10px; position: relative;">
            <span class="green-text text-darken-4" style="margin: 0;">@TempData["SuccessMessage"]</span>
            <span class="close-btn">&times;</span>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-container responsive-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Fabricante</th>
                        <th>Categoría de Producto</th>
                        <th>Categoría de Animal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>@product.ProductId</td>
                            <td>@product.Name</td>
                            <td>@product.Price</td>
                            <td>@product.Stock</td>
                            <td>@product.Make.Name</td>
                            <td>@product.ProductCategory.Name</td>
                            <td>@product.AnimalCategory.Name</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a href="@Url.Action("Edit", "Product", new { id = product.ProductId })" class="btn-small waves-effect waves-light">Editar</a>
                                    <a href="@Url.Action("Delete", "Product", new { id = product.ProductId })" class="btn-small red waves-effect waves-light">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="center-align">
        <a href="@Url.Action("Create", "Product")" class="btn waves-effect waves-light">Agregar Producto</a>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var closeBtn = document.querySelector('.close-btn');
        if (closeBtn) {
            closeBtn.addEventListener('click', function () {
                var successMessage = document.getElementById('success-message');
                if (successMessage) {
                    successMessage.style.display = 'none';
                }
            });
        }

        setTimeout(function () {
            var successMessage = document.getElementById('success-message');
            if (successMessage) {
                successMessage.style.display = 'none';
            }
        }, 2000);
    });
</script>
