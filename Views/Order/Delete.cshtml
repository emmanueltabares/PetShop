@using PetShop.ViewModel;
@model PetShop.ViewModel.OrderViewModels.OrderDeleteViewModel;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

<div class="container">
    <h4 class="center-align red-text">Eliminar Orden</h4>
    <p>¿Estás seguro de que deseas eliminar la orden <strong>@Model.OrderId</strong>?</p>
    <p><strong>Esta acción no se puede deshacer.</strong></p>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="ProductId" value="@Model.OrderId" />
        <button type="submit" class="btn red waves-effect waves-light">Eliminar</button>
        <a href="@Url.Action("Index", "Order")" class="btn grey waves-effect waves-light">Cancelar</a>
    </form>
</div>
