@using Microsoft.AspNetCore.Identity;
@model PetShop.ViewModel.UserViewModels.UserCreateViewModel

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

<style>
    .container {
        width: 90%;
        margin: 0 auto;
    }
    .table-container {
        width: 100%;
        margin: 0 auto;
    }
    .action-buttons {
        display: inline-block;
        justify-content: center;
        align-items: center;
        gap: 5px;
    }
    .action-cell {
        justify-content: center;
        align-items: center;
        padding: 8px 16px;
        text-align: right;
        white-space: nowrap;
    }
    .action-buttons a {
        margin: 0 5px;
        padding: 0 10px;
        font-size: 0.8rem;
        margin-left: 5px;
    }
    th, td {
        padding: 8px 16px;
        vertical-align: middle;
    }
    .close-btn {
        cursor: pointer;
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 18px;
    }
</style>

<div class="container">
    <form asp-action="Create" method="post">
        <div class="input-field">
            <input type="text" id="UserName" name="UserName" required>
            <label for="UserName">Nombre de usuario</label>
        </div>
        <div class="input-field">
            <select id="RoleId" name="RoleId">
                <option value="" disabled selected>Seleccione un rol</option>
                @foreach (var rol in Model.Roles)
                {
                    <option value="@rol.Value">@rol.Text</option>
                }
            </select>
            <label for="RoleId">Rol de usuario</label>
        </div>
        <div class="input-field">
            <input type="email" id="Email" name="Email">
            <label for="Email">Email</label>
        </div>
        <div class="input-field">
            <input type="number" id="Phone" name="Phone"></input>
            <label for="Phone">Teléfono</label>
        </div>
        <button type="submit" class="btn waves-effect waves-light">Guardar</button>
        <a href="@Url.Action("Index", "User")" class="btn grey waves-effect waves-light">Volver</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}